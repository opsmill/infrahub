{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/opsmill/infrahub/dev/specs/dependabot-autopilot/verdict.schema.json",
  "title": "Dependabot autopilot verdict report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pr_number", "head_sha", "verdict", "packages", "report_markdown"],
  "properties": {
    "schema_version": { "const": 1 },
    "pr_number": { "type": "integer", "minimum": 1 },
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "verdict": { "$ref": "#/$defs/verdict" },
    "report_markdown": { "type": "string", "minLength": 1, "maxLength": 60000 },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/package" }
    }
  },
  "$defs": {
    "verdict": { "enum": ["safe-to-merge", "needs-code-changes", "review-required"] },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ecosystem", "from_version", "to_version", "verdict", "impacts", "opportunities"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "ecosystem": { "enum": ["github-actions", "uv", "npm"] },
        "from_version": { "type": "string" },
        "to_version": { "type": "string" },
        "verdict": { "$ref": "#/$defs/verdict" },
        "impacts": { "type": "array", "items": { "$ref": "#/$defs/impact" } },
        "opportunities": { "type": "array", "items": { "$ref": "#/$defs/opportunity" } }
      },
      "if": { "properties": { "verdict": { "const": "needs-code-changes" } } },
      "then": { "properties": { "impacts": { "minItems": 1 } } }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "path", "line"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 }
      }
    },
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "category", "summary", "code_refs"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9._-]+:[a-z0-9._/-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "enum": ["security", "deprecation-deadline", "performance", "simplification", "other"] },
        "summary": { "type": "string", "minLength": 1 },
        "code_refs": { "type": "array", "items": { "type": "string", "pattern": "^[^:]+:[0-9]+$" } }
      }
    }
  }
}
