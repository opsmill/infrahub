{
  "$schema": "../node_modules/@biomejs/biome/configuration_schema.json",
  // Shared formatter, assist and lint configuration lives in ../biome.jsonc.
  "extends": "//",
  "files": {
    "includes": [
      "!coverage",
      "!dist",
      "!playwright-report",
      "!test-results",
      "!tests/e2e/.auth",
      "!src/shared/api/rest/types.generated.ts",
      "!src/shared/api/errors/catalogue.generated.ts",
      "!src/shared/api/graphql/generated"
    ]
  },
  "linter": {
    "rules": {
      "nursery": {
        "noTailwindArbitraryValue": {
          "level": "error",
          "options": {
            "attributes": [
              "activeClassName",
              "activeLinkClassName",
              "breakClassName",
              "breakLinkClassName",
              "calendarClassName",
              "containerClassName",
              "contentClass",
              "enter",
              "enterFrom",
              "enterTo",
              "iconClassName",
              "keyClassName",
              "labelClassName",
              "leave",
              "leaveFrom",
              "leaveTo",
              "leftClassName",
              "loadingClassName",
              "nextClassName",
              "nextLinkClassName",
              "pageClassName",
              "pageLinkClassName",
              "popperClassName",
              "preClassName",
              "previousClassName",
              "previousLinkClassName",
              "rightClassName",
              "scrollBarClassName",
              "textareaClassName",
              "valueClassName",
              "wrapperClass",
              "wrapperClassName"
            ],
            // Helpers that exist in this tree, plus tv: packages/ui is built on
            // tailwind-variants, so it is the one name likely to arrive here later.
            "functions": ["classNames", "clsx", "cva", "twMerge", "tv"]
          }
        }
      }
    }
  }
}
