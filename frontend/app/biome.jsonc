{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "!coverage",
      "!dist",
      "!playwright-report",
      "!test-results",
      "!tests/e2e/.auth",
      "!src/shared/api/graphql/graphql-env.d.ts",
      "!src/shared/api/graphql/graphql-cache.d.ts",
      "!src/shared/api/rest/types.generated.ts",
      "!src/shared/api/graphql/generated"
    ]
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100,
    "attributePosition": "auto",
    "bracketSpacing": true
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "identifierOrder": "natural",
            "groups": [
              ":URL:",
              ":BLANK_LINE:",
              [":BUN:", ":NODE:"],
              ":BLANK_LINE:",
              [":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:"],
              ":BLANK_LINE:",
              [":ALIAS:", "!@/shared/**", "!@/entities/**"],
              ":BLANK_LINE:",
              "@/shared/**",
              ":BLANK_LINE:",
              "@/entities/**",
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        },
        "useSortedAttributes": "off",
        "useSortedKeys": "off",
        "useSortedProperties": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useAriaPropsForRole": "off",
        "useButtonType": "off",
        "useKeyWithClickEvents": "off",
        "useSemanticElements": "off",
        "noNoninteractiveElementInteractions": "off",
        "noStaticElementInteractions": "off"
      },
      "complexity": {
        "noBannedTypes": "off",
        "noExcessiveCognitiveComplexity": "off",
        "noForEach": "off",
        "noImportantStyles": "off",
        "noUselessFragments": "off",
        "noUselessSwitchCase": "off",
        "noUselessThisAlias": "off",
        "useArrowFunction": "off",
        "useDateNow": "off",
        "useOptionalChain": "off",
        "useSimplifiedLogicExpression": "off",
        "noArguments": "off"
      },
      "correctness": {
        "useImageSize": "off",
        "noUndeclaredDependencies": "error",
        "noUndeclaredVariables": "off",
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": true
          }
        },
        "noNestedComponentDefinitions": "off",
        "useExhaustiveDependencies": "off",
        "useHookAtTopLevel": "off",
        "useImportExtensions": "off",
        "noSwitchDeclarations": "off",
        "useUniqueElementIds": "off"
      },
      "nursery": {
        "useFind": "error",
        "useConsistentArrowReturn": "off",
        "useExhaustiveSwitchCases": "off",
        "noUnnecessaryConditions": "off",
        "useMaxParams": "off",
        "noReactForwardRef": "off",
        "noShadow": "off"
      },
      "performance": {
        "noAccumulatingSpread": "off",
        "noImgElement": "off",
        "useTopLevelRegex": "off",
        "noNamespaceImport": "off"
      },
      "style": {
        "noDefaultExport": "off",
        "noEnum": "off",
        "noExportedImports": "off",
        "noImplicitBoolean": "off",
        "noInferrableTypes": "off",
        "noNamespace": "off",
        "noNegationElse": "off",
        "noNonNullAssertion": "off",
        "noNestedTernary": "off",
        "noUselessElse": "off",
        "useBlockStatements": "off",
        "useConsistentArrayType": "off",
        "useConsistentBuiltinInstantiation": "off",
        "useConsistentTypeDefinitions": "off",
        "useConst": "off",
        "useDefaultSwitchClause": "off",
        "useEnumInitializers": "off",
        "useExplicitLengthCheck": "off",
        "useFilenamingConvention": "off",
        "useImportType": "error",
        "useNamingConvention": "off",
        "useNumberNamespace": "off",
        "useSelfClosingElements": "off",
        "noMagicNumbers": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noAssignInExpressions": "off",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["assert", "error", "info", "warn"]
          }
        },
        "noEmptyBlock": "off",
        "noEmptyBlockStatements": "off",
        "noNonNullAssertedOptionalChain": "off",
        "noUnknownAtRules": "off",
        "noEvolvingTypes": "off",
        "noExplicitAny": "off",
        "noGlobalIsNan": "off",
        "noImplicitAnyLet": "off",
        "noReactSpecificProps": "off",
        "useIterableCallbackReturn": "off",
        "useAwait": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "es5",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "quoteStyle": "double",
      "attributePosition": "auto",
      "bracketSpacing": true
    }
  },
  "graphql": {
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  },
  "extends": ["ultracite/core", "ultracite/react"]
}
