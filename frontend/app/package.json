{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "git submodule update --init --recursive && pnpm install",
    "submodule:update": "git submodule update --remote ../../frontend/packages/schema-visualizer && pnpm install",
    "start": "vite",
    "dev": "VITE_DEVTOOLS=1 vite",
    "build": "vite build",
    "serve": "vite preview",
    "build-serve": "pnpm build && pnpm serve",
    "codegen": "graphql-codegen --config graphql.config.ts",
    "codegen:openapi": "npx openapi-typescript ../../schema/openapi.json --output src/shared/api/rest/types.generated.ts",
    "codegen:graphql": "gql.tada generate output && gql.tada generate turbo",
    "ci:test:e2e": "CI=1 DEBUG=pw:browser pnpm test:e2e 2>/dev/null",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:screenshots": "UPDATE_DOCS_SCREENSHOTS=1 INFRAHUB_ADDRESS=http://localhost:8000 playwright test",
    "test:e2e:screenshots:headed": "UPDATE_DOCS_SCREENSHOTS=1 INFRAHUB_ADDRESS=http://localhost:8000 playwright test --headed",
    "biome": "biome check .",
    "biome:fix": "biome check --write .",
    "knip": "knip",
    "betterer": "betterer"
  },
  "dependencies": {
    "@apollo/client": "3.13.8",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.1",
    "@graphiql/plugin-explorer": "^5.1.1",
    "@graphiql/toolkit": "^0.11.3",
    "@headlessui/react": "^2.2.10",
    "@iconify-icon/react": "^3.0.3",
    "@iconify-json/mdi": "^1.2.3",
    "@infrahub/ui": "file:../packages/ui",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.99.2",
    "@tanstack/react-query-devtools": "^5.99.2",
    "@tanstack/react-table": "^8.21.3",
    "@uiw/react-color": "^2.10.1",
    "@vitejs/plugin-react": "^6.0.1",
    "apollo-upload-client": "18.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cm6-graphql": "^0.2.1",
    "cm6-theme-basic-light": "^0.2.0",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "gql.tada": "^1.9.2",
    "graphiql": "^5.2.2",
    "graphql": "^16.13.2",
    "infrahub-schema-visualizer": "file:../packages/schema-visualizer",
    "jotai": "^2.19.1",
    "json-to-graphql-query": "^2.3.0",
    "lucide-react": "^1.8.0",
    "monaco-editor": "0.52.2",
    "monaco-graphql": "^1.7.3",
    "nuqs": "^2.8.9",
    "openapi-fetch": "^0.17.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.5",
    "react-aria-components": "^1.17.0",
    "react-datepicker": "8.1.0",
    "react-diff-view": "^3.3.3",
    "react-dom": "^19.2.5",
    "react-error-boundary": "^6.1.1",
    "react-hook-form": "^7.73.1",
    "react-markdown": "^10.1.0",
    "react-paginate": "^8.3.0",
    "react-resizable-panels": "^4.10.0",
    "react-router": "^7.14.2",
    "react-scan": "^0.5.3",
    "react-simple-code-editor": "^0.14.1",
    "react-syntax-highlighter": "^16.1.1",
    "react-toastify": "9.1.3",
    "recharts": "^3.8.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remeda": "^2.33.7",
    "sha1": "^1.1.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "unidiff": "^1.0.4",
    "vite": "^8.0.9",
    "vite-plugin-monaco-editor-esm": "^2.0.2",
    "vite-plugin-svgr": "^5.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@betterer/cli": "6.0.0-alpha.1",
    "@betterer/typescript": "6.0.0-alpha.1",
    "@biomejs/biome": "^2.4.12",
    "@graphql-codegen/cli": "^6.3.1",
    "@graphql-codegen/typescript": "^5.0.10",
    "@graphql-codegen/typescript-operations": "^5.1.0",
    "@playwright/test": "1.56.1",
    "@types/apollo-upload-client": "18.0.1",
    "@types/node": "^25.6.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/sha1": "^1.1.5",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "knip": "^6.6.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "ultracite": "^7.6.0",
    "vitest": "^4.1.5",
    "vitest-browser-react": "^2.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "esbuild",
      "playwright",
      "playwright-core"
    ],
    "overrides": {
      "playwright": "1.56.1",
      "playwright-core": "1.56.1"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "graphiql-explorer>graphql": "^16.0.0",
        "graphiql-explorer>react": "^19.0.0",
        "graphiql-explorer>react-dom": "^19.0.0"
      }
    }
  },
  "engines": {
    "node": ">=24.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
