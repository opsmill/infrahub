{
  "name": "@infrahub/frontend",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "esbuild",
      "msgpackr-extract",
      "playwright",
      "playwright-core"
    ],
    "overrides": {
      "playwright": "1.56.1",
      "playwright-core": "1.56.1"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "graphiql-explorer>graphql": "^16.0.0",
        "graphiql-explorer>react": "^19.0.0",
        "graphiql-explorer>react-dom": "^19.0.0"
      }
    }
  }
}
