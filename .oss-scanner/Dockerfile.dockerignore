# Replaces the root .dockerignore for this image, which leaves out tracked files such as .gitmodules and .github:
# the submodule update needs .gitmodules, and missing tracked files would show as deletions in the scanner's patches.
**/node_modules
**/.venv
**/__pycache__
**/.ruff_cache
**/.mypy_cache
**/.pytest_cache
**/*.env
.envrc
.direnv/
docs/build
docs/.docusaurus
