    "sequence": {
      "source": "- id: base\n  type: shell\n  run: git rev-parse HEAD | tr -d '\\n'\n- id: preflight\n  type: shell\n  run: 'd=''{{ inputs.spec_dir }}''; for f in spec.md plan.md tasks.md; do test -f\n    \"$d/$f\" || { echo \"BLOCKED: $d/$f is missing\" >&2; exit 1; }; done; test -z \"$(git\n    status --porcelain -- . '':!.specify/workflows/runs'')\" || { echo ''BLOCKED: the\n    working tree has uncommitted changes'' >&2; exit 1; }'\n- id: chunks\n  type: do-while\n  max_iterations: 20\n  condition: '{{ steps.left.output.stdout != ''0'' and steps.left.output.stdout !=\n    steps.before.output.stdout }}'\n  steps:\n  - id: before\n    type: shell\n    run: '{ grep -c ''^[[:space:]]*- \\[ \\]'' ''{{ inputs.spec_dir }}/tasks.md'' ||\n      true; } | tr -d ''\\n'''\n  - id: chunk\n    command: speckit.opsmill.implement-chunk\n    integration: '{{ inputs.integration }}'\n    input:\n      args: '{{ inputs.spec_dir }}'\n  - id: commit-chunk\n    type: shell\n    run: 'git add -A && (git diff --cached --quiet || git commit -q -m ''implement:\n      changes that the chunk left uncommitted'')'\n  - id: left\n    type: shell\n    run: '{ grep -c ''^[[:space:]]*- \\[ \\]'' ''{{ inputs.spec_dir }}/tasks.md'' ||\n      true; } | tr -d ''\\n'''\n- id: review\n  command: speckit.opsmill.implement-review\n  integration: '{{ inputs.integration }}'\n  input:\n    args: '{{ inputs.spec_dir }} {{ steps.base.output.stdout }}'\n- id: commit-review\n  type: shell\n  run: 'git add -A && (git diff --cached --quiet || git commit -q -m ''review: fixes\n    of the high-severity findings'')'\n- id: report\n  command: speckit.opsmill.implement-report\n  integration: '{{ inputs.integration }}'\n  capture: true\n  timeout: 1800\n  input:\n    args: '{{ inputs.spec_dir }} {{ steps.base.output.stdout }}'\n- id: commit-report\n  type: shell\n  run: 'git add -A && (git diff --cached --quiet || git commit -q -m ''report: implementation\n    and review report'')'\n- id: not-done\n  type: if\n  condition: '{{ not (steps.report.output.stdout | contains(''STATUS: DONE | SPEC_DIR:''))\n    }}'\n  then:\n  - id: stop-on-incomplete\n    type: shell\n    run: 'echo ''INCOMPLETE: the implementation did not end with STATUS: DONE; see\n      opsmill-implement-report.md in the spec directory'' >&2; exit 1'\n",
