{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PR_REVIEW": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "dev/setup-environment.sh"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/speckit-python.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*gh pr create*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/pr-review.sh claude"
          },
          {
            "type": "command",
            "if": "Bash(*git push*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/pr-review.sh push"
          }
        ]
      }
    ]
  }
}
