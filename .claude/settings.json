{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "infrahub": {
      "source": {
        "source": "directory",
        "path": "./.agents"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "dev/setup-environment.sh"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.specify/extensions/opsmill/scripts/bash/python-env.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*gh pr create*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/pr-review.sh claude"
          },
          {
            "type": "command",
            "if": "Bash(*git push*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/pr-review.sh push"
          }
        ]
      },
      {
        "matcher": "mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/pr-review.sh claude"
          }
        ]
      }
    ]
  }
}
